# Emlak CRM Pro - Environment Variables
# Copy this file to .env and fill in the values

# Supabase Configuration (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Drive Integration (for document management)
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable Google Drive API and Google Picker API
# 3. Create OAuth 2.0 credentials (Web application type)
# 4. Add your domain to authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key

# Google Takvim, Görevler ve Drive OAuth (yalnızca Vercel sunucu ortamı)
# Google Cloud: Calendar API, Tasks API, Drive API, Picker API ve Maps JavaScript API'yi etkinleştirin.
# Redirect URI: https://YOUR_DOMAIN/api/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/google
APP_ORIGIN=https://YOUR_DOMAIN
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary CDN (fotoğraf yükleme için — Supabase yükünü azaltır)
# Kurulum: https://cloudinary.com → ücretsiz hesap aç
#   1. Dashboard'dan Cloud Name'i kopyala
#   2. Settings → Upload → "Add upload preset" → Mode: Unsigned → preset adını kopyala
# Bu değerler olmadan uygulama çalışır, fotoğraflar base64 olarak kaydedilir (eski davranış).
VITE_CLOUDINARY_CLOUD_NAME=senin_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=emlak_unsigned
